{
  "id": "ip_lysis",
  "name": "IP / Co-IP Lysis Buffer",
  "category": "buffer",
  "tags": [
    "IP",
    "Co-IP",
    "protein interaction"
  ],
  "components": [
    {
      "name": "1M Tris-HCl pH 7.4",
      "amount": 2.5,
      "unit": "mL",
      "note": {
        "en": "Final concentration 25 mM",
        "zh": "终浓度 25 mM"
      }
    },
    {
      "name": "5M NaCl",
      "amount": 3,
      "unit": "mL",
      "note": {
        "en": "Final concentration 150 mM",
        "zh": "终浓度 150 mM"
      }
    },
    {
      "name": "NP-40 / IGEPAL CA-630",
      "amount": 1,
      "unit": "mL",
      "note": {
        "en": "Final concentration 1%",
        "zh": "终浓度 1%"
      }
    },
    {
      "name": "0.5M EDTA pH 8.0",
      "amount": 0.2,
      "unit": "mL",
      "note": {
        "en": "Final concentration 1 mM",
        "zh": "终浓度 1 mM"
      }
    },
    {
      "name": "100% Glycerol",
      "amount": 5,
      "unit": "mL",
      "note": {
        "en": "Final concentration 5%",
        "zh": "终浓度 5%"
      }
    },
    {
      "name": "ddH₂O",
      "amount": 88.3,
      "unit": "mL"
    }
  ],
  "nameCn": "免疫沉淀裂解液",
  "notes": {
    "en": "Add protease/phosphatase inhibitors before use. For Co-IP use mild detergent (0.5% NP-40) to preserve interactions. Lyse on ice 30 min, centrifuge at 4°C 14,000×g for 15 min.",
    "zh": "使用前加蛋白酶/磷酸酶抑制剂。Co-IP 用温和去垢剂 (0.5% NP-40) 保持蛋白互作。冰上裂解 30 min，4°C 14,000×g 离心 15 min。"
  },
  "ref": "Miernyk & Thelen (2008) Plant J 55:415–425; Nature Protocols",
  "discipline": [
    "protein",
    "cell"
  ],
  "storage": {
    "temperature": "4°C",
    "duration": "3 months",
    "sterile": "not_required",
    "notes": "Add protease/phosphatase inhibitors fresh"
  },
  "usage": {
    "en": "Native lysis buffer optimized for immunoprecipitation (IP) and Co-IP experiments.",
    "zh": "专为 IP 和 Co-IP 优化的天然条件裂解缓冲液。"
  },
  "volume": 100,
  "volumeUnit": "mL",
  "prepSteps": [
    {
      "en": "Dissolve Tris-HCl, NaCl, NP-40, EDTA in ddH₂O",
      "zh": "将 Tris-HCl、NaCl、NP-40、EDTA 溶于 ddH₂O"
    },
    {
      "en": "Adjust pH to 7.4",
      "zh": "调 pH 至 7.4"
    },
    {
      "en": "Filter-sterilize, store at 4°C",
      "zh": "0.22 µm 过滤除菌，4°C 保存"
    },
    {
      "en": "Add protease inhibitors immediately before use",
      "zh": "使用前立即加入蛋白酶抑制剂"
    }
  ],
  "crosslinks": [
